# Copy to .env.local and edit. Every variable is optional: with none set, the app runs the local
# deterministic simulation (no LLM, no network). NEXT_PUBLIC_* values are inlined at build time,
# so restart `npm run dev` (or rebuild) after changing them.

# Backend: unset (or "mock") = local simulation; "websocket" = a real backend speaking protocol v1.
NEXT_PUBLIC_AGENT_BACKEND=

# WebSocket URL when NEXT_PUBLIC_AGENT_BACKEND=websocket. Default: ws://127.0.0.1:8787/
# (the example server in examples/phase1-engine of the prompt repository).
NEXT_PUBLIC_AGENT_WS_URL=

# Optional shared secret, sent in the `hello` message (never in the WebSocket URL). It ships in the
# client bundle, so it only keeps out other local pages and tools, not someone who can load this app.
# Prefer opening the app as /?token=… (the link `npm run server -- --control` prints): a URL token
# wins over this one, is kept in sessionStorage for reloads, and is removed from the address bar.
# A server started with --control (sessions: read, prompt, answer permission asks) requires a token.
NEXT_PUBLIC_AGENT_WS_TOKEN=
