{
  "name": "ai-agent-world",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node --experimental-strip-types --no-warnings scripts/simulate.ts && npm run test:sound --silent && npm run test:sessions --silent",
    "test:sound": "node --experimental-strip-types --no-warnings scripts/sound-test.ts",
    "test:sessions": "node --experimental-strip-types --no-warnings scripts/sessions-test.ts",
    "e2e": "playwright test",
    "build:live": "node --experimental-strip-types --no-warnings scripts/live.ts build",
    "start:live": "node --experimental-strip-types --no-warnings scripts/live.ts start"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3"
  }
}
